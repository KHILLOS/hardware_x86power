cc_library_shared {
    name: "power.x86",
    srcs: ["power.c"],
    relative_install_path: "hw",
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    vendor_available: true,
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
